{
  "name": "vite-ts-tailwind-starter",
  "version": "3.1.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "start": "pnpm dev & wait-on tcp:3000 -v",
